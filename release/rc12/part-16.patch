+		return conn, nil
+	}}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: 15 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, "https://"+host+"/cdn-cgi/trace", nil)
+	if err != nil {
+		return "", err
+	}
+	req.Header.Set("User-Agent", "ITOM exit identity")
+	resp, err := client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return "", errors.New("EXIT_HTTP_STATUS")
+	}
+	raw, err := io.ReadAll(io.LimitReader(resp.Body, 8193))
+	if err != nil || len(raw) > 8192 {
+		return "", errors.New("EXIT_RESPONSE_INVALID")
+	}
+	result, err := parseExitTrace(string(raw))
+	if err != nil {
+		return "", err
+	}
+	if c.currentPool() != pool || c.rebinding.Load() || ctx.Err() != nil {
+		return "", errors.New("EXIT_GENERATION_CHANGED")
+	}
+	data, err := json.Marshal(result)
+	return string(data), err
+}
diff --git a/src/native/exit_identity_parser.go b/src/native/exit_identity_parser.go
new file mode 100644
index 0000000..a888372
--- /dev/null
+++ b/src/native/exit_identity_parser.go
@@ -0,0 +1,38 @@
+package mobile
+
+import (
+	"errors"
+	"net/netip"
+	"strings"
+)
+
+type exitIdentity struct {
+	IP      string `json:"ip"`
+	Country string `json:"country"`
+}
+
+func parseExitTrace(raw string) (exitIdentity, error) {
+	var result exitIdentity
+	for _, line := range strings.Split(raw, "\n") {
+		key, value, ok := strings.Cut(strings.TrimSpace(line), "=")
+		if !ok {
+			continue
+		}
+		switch key {
+		case "ip":
+			ip, err := netip.ParseAddr(value)
+			if err != nil || ip.Zone() != "" || !ip.IsGlobalUnicast() || ip.IsPrivate() {
+				return exitIdentity{}, errors.New("EXIT_IP_INVALID")
+			}
+			result.IP = ip.String()
+		case "loc":
+			if len(value) == 2 && value[0] >= 'A' && value[0] <= 'Z' && value[1] >= 'A' && value[1] <= 'Z' && value != "XX" {
+				result.Country = value
+			}
+		}
+	}
+	if result.IP == "" {
+		return exitIdentity{}, errors.New("EXIT_IP_MISSING")
+	}
+	return result, nil
+}
