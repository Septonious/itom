+
+func TestRC7SpeedupReallyStartsBeforeApplicationOpen(t *testing.T) {
+	steps := []providerCapStep{{Mbps: 10}, {Mbps: 20}, {Mbps: 50}, {Mbps: 150}}
+	if got := initialProviderProfileMbps(steps, 150, true); got != 10 {
+		t.Fatalf("false startup speedup, got %g", got)
+	}
+	if got := initialProviderProfileMbps(steps, 150, false); got != 150 {
+		t.Fatalf("downgrade control changed, got %g", got)
+	}
+	if got := initialProviderProfileMbps(nil, 150, true); got != 150 {
+		t.Fatalf("empty profile fallback changed, got %g", got)
+	}
+}
diff --git a/tunnel/rc8_release_gate_test.go b/tunnel/rc8_release_gate_test.go
new file mode 100644
index 0000000..6a32c59
--- /dev/null
+++ b/tunnel/rc8_release_gate_test.go
@@ -0,0 +1,48 @@
+package tunnel
+
+import (
+	"math"
+	"testing"
+	"time"
+)
+
+const rc8MinimumDuplexMbps = 75.0
+const rc8MaximumLoadedRTT = 750 * time.Millisecond
+
+// RC8 speed numbers refer to an unconstrained >=150Mbps synthetic provider.
+// The verified rate also includes sustained 30s and final-10s tails, excluding
+// a transient peak that might mask an eventual stalled direction.
+func rc8ReleasePerformanceGate(upload, download, verified float64, rtt time.Duration, minimum float64) bool {
+	if math.IsNaN(minimum) || math.IsInf(minimum, 0) || minimum < rc8MinimumDuplexMbps {
+		return false
+	}
+	return strictSpeedGate(upload, minimum) && strictSpeedGate(download, minimum) &&
+		strictSpeedGate(verified, minimum) && rtt > 0 && rtt <= rc8MaximumLoadedRTT
+}
+
+func TestRC8NoThroughputWaiverAndStrictRTT(t *testing.T) {
+	cases := []struct {
+		up, down, verified float64
+		rtt                time.Duration
+		want               bool
+	}{
+		{75, 75, 75, 750 * time.Millisecond, true},
+		{90, 78, 76, 600 * time.Millisecond, true},
+		{74.999, 200, 74.999, 300 * time.Millisecond, false},
+		{125, 74.999, 74.999, 300 * time.Millisecond, false},
+		{100, 100, 74.999, 400 * time.Millisecond, false},
+		{100, 100, 100, 750*time.Millisecond + time.Nanosecond, false},
+		{100, 100, 100, 0, false},
+		{math.NaN(), 90, 90, 600 * time.Millisecond, false},
+	}
+	for _, tc := range cases {
+		if got := rc8ReleasePerformanceGate(tc.up, tc.down, tc.verified, tc.rtt, 75); got != tc.want {
+			t.Fatalf("RC8 gate up=%.4f down=%.4f tail=%.4f RTT=%v got=%v want=%v", tc.up, tc.down, tc.verified, tc.rtt, got, tc.want)
+		}
+	}
+	for _, min := range []float64{0, 74.999, math.NaN(), math.Inf(1)} {
+		if rc8ReleasePerformanceGate(100, 100, 100, 500*time.Millisecond, min) {
+			t.Fatalf("RC8 let release lower its floor to %g", min)
+		}
+	}
+}
