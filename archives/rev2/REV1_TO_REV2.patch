+	if at > 0 && now.UnixMilli() >= at {
+		line.RTTSampleAgeMS = now.UnixMilli() - at
+		line.RTTFresh = line.RTTSampleAgeMS <= 15000 && line.RTTMillis > 0
+	}
+}
