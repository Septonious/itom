diff --git a/archives/1.1.0/source/core/transport/imap_publication_turn.go b/archives/1.1.0/source/core/transport/imap_publication_turn.go
new file mode 100644
index 0000000..8505de7
--- /dev/null
+++ b/archives/1.1.0/source/core/transport/imap_publication_turn.go
@@ -0,0 +1,63 @@
+package transport
+
+import "context"
+
+// A publication must select an available physical writer before it charges and
+// seals a BODY. Otherwise destructive cleanup can capture a logical record on
+// a socket that cannot write it, starving healthy independent carriers.
+func (e *Executor) tryPublicationPreparation() bool {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if e.closed != nil || e.destructiveActive || e.destructiveWaiters > 0 {
+		return false
+	}
+	e.publicationPreparations++
+	return true
+}
+func (e *Executor) releasePublicationPreparation() {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.publicationPreparations--
+	e.signalSpaceLocked()
+}
+func (e *Executor) acquireDestructive(ctx context.Context) (func(), error) {
+	e.mu.Lock()
+	e.destructiveWaiters++
+	e.mu.Unlock()
+	waiting := true
+	defer func() {
+		if waiting {
+			e.mu.Lock()
+			e.destructiveWaiters--
+			e.signalSpaceLocked()
+			e.mu.Unlock()
+		}
+	}()
+	for {
+		e.mu.Lock()
+		if err := ctx.Err(); err != nil {
+			e.mu.Unlock()
+			return nil, err
+		}
+		if e.closed != nil {
+			e.mu.Unlock()
+			return nil, ErrClosed
+		}
+		if !e.destructiveActive && e.publicationPreparations == 0 {
+			e.destructiveWaiters--
+			waiting = false
+			e.destructiveActive = true
+			e.mu.Unlock()
+			return func() { e.mu.Lock(); e.destructiveActive = false; e.signalSpaceLocked(); e.mu.Unlock() }, nil
+		}
+		space := e.space
+		e.mu.Unlock()
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-e.done:
+			return nil, ErrClosed
+		case <-space:
+		}
+	}
+}
