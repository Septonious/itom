+// PING/OPEN/cleanup control demand belongs to the control reader. Waking an
+// unrelated DATA IDLE adds DONE/FETCH turns to every account; only actual
+// request DATA or a socket borrower may demand that wake.
+func TestDEV9ControlDemandDoesNotWakeIndependentDataReader(t *testing.T) {
+	m := &laneMail{dataReaderWake: make(chan struct{}, 1)}
+	m.SetReaderHot(time.Now().Add(time.Second))
+	if len(m.dataReaderWake) != 0 {
+		t.Fatal("generic control demand woke independent DATA IDLE")
+	}
+	if m.readerHotUntil.Load() <= time.Now().UnixNano() {
+		t.Fatal("control response search was not armed")
+	}
+	m.wakeDataReader()
+	if len(m.dataReaderWake) != 1 {
+		t.Fatal("explicit DATA wake lost")
+	}
+}
