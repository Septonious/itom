+// Only authenticated application setup/small incoming requests justify the
+// bounded server receive search; bulk and receipt/control traffic leave IDLE.
+func TestDEV9ServerRequestPrimesOnlyProtectedAndActualDataReaders(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		kind wire.Type
+		size int
+		want bool
+	}{
+		{"open", wire.Open, 0, true}, {"small", wire.Data, 32, true},
+		{"bulk", wire.Data, 32 << 10, false}, {"ack", wire.Receipt, 0, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			g := newStripeGroup(wire.ID{1}, 1)
+			for i := 1; i <= 5; i++ {
+				l := stripeTestLane(g, fmt.Sprintf("a%02d", i), true)
+				t.Cleanup(l.cancel)
+				l.dataShards = 1
+				l.mail = &laneMail{baseData: true, dataReaderWake: make(chan struct{}, 1)}
+				l.ownerFrames = make(chan wire.Frame, 2)
+				if e := g.attach(l); e != nil {
+					t.Fatal(e)
+				}
+			}
+			owner, carrier := g.lanes["a02"], g.lanes["a03"]
+			if e := g.register(1, owner); e != nil {
+				t.Fatal(e)
+			}
+			if e := g.dispatchStream(carrier, wire.Frame{Type: tc.kind, Stream: 1, Payload: make([]byte, tc.size)}); e != nil {
+				t.Fatal(e)
+			}
+			for id, l := range g.lanes {
+				m := physicalMail(l.mail)
+				want := tc.want && (id == "a01" || id == "a03")
+				if got := m.dataResponseUntil.Load() > time.Now().UnixNano(); got != want {
+					t.Fatalf("%s armed=%t want=%t", id, got, want)
+				}
+				if len(m.dataReaderWake) > 0 != want {
+					t.Fatalf("%s DATA wake mismatch", id)
+				}
+			}
+		})
+	}
+}
