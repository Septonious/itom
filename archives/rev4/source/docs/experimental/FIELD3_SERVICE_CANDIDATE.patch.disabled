+// Reserve at most N-1 maintenance lanes while N healthy DATA carriers exist.
+// Cleanup intent counts too, so waiting for in-flight fast work cannot reserve
+// every carrier and black-hole the session's interactive DATA. With one carrier
+// maintenance must proceed; its existing bounded cleanup pass remains the cap.
+func (g *stripeGroup) reserveCleanup(l *lane) bool {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.cleanupLanes[l] {
+		return true
+	}
+	ready := 0
+	for _, p := range g.lanes {
+		if p == nil || !p.ready.Load() || (p.ctx != nil && p.ctx.Err() != nil) {
+			continue
+		}
+		if a, ok := p.mail.(interface{ DataAvailable() bool }); ok && !a.DataAvailable() {
+			continue
+		}
+		ready++
+	}
+	limit := ready - 1
+	if limit < 1 {
+		limit = 1
+	}
+	if len(g.cleanupLanes) >= limit {
+		return false
+	}
+	if g.cleanupLanes == nil {
+		g.cleanupLanes = make(map[*lane]bool)
+	}
+	g.cleanupLanes[l] = true
+	return true
+}
+func (g *stripeGroup) releaseCleanup(l *lane) {
+	g.mu.Lock()
+	delete(g.cleanupLanes, l)
+	g.mu.Unlock()
+	g.signal()
+}
