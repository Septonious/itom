+// Closed remote bulk leases still hold physical debt, but are not usable. Keep
+// newly freed headroom for their replacement instead of letting local bulk
+// APPENDs repeatedly consume it first. This is admission service, never refund.
+func (l *lane) updateBulkRefillReserve() {
+	_, active := l.issuedGrantCounts()
+	missing := remoteBulkLeases - active
+	if missing < 0 {
+		missing = 0
+	}
+	l.bulkRefillReserve.Store(uint64(missing) * dataLeaseBytes)
+}
